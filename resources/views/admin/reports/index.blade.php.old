    border-left: 0.25rem solid #858796 !important;
}
</style>
@endpush

@push('scripts')
<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<script>
// Chart colors
const chartColors = {
    primary: '#4e73df',
    success: '#1cc88a',
    info: '#36b9cc',
    warning: '#f6c23e',
    danger: '#e74a3b',
    secondary: '#858796',
};

// 1. Biểu đồ cột: Số hội thảo theo năm
const conferencesByYearCtx = document.getElementById('conferencesByYearChart').getContext('2d');
new Chart(conferencesByYearCtx, {
    type: 'bar',
    data: {
        labels: @json($yearsData),
        datasets: [{
            label: 'Số hội thảo',
            data: @json($conferenceCountsData),
            backgroundColor: chartColors.primary,
            borderColor: chartColors.primary,
            borderWidth: 1
        }]
    },
    options: {
        responsive: true,
        maintainAspectRatio: true,
        scales: {
            y: {
                beginAtZero: true,
                ticks: {
                    precision: 0
                }
            }
        },
        plugins: {
            legend: {
                display: false
            }
        }
    }
});

// 2. Biểu đồ doughnut: Phân bố bài báo theo track
const papersByTrackCtx = document.getElementById('papersByTrackChart').getContext('2d');
new Chart(papersByTrackCtx, {
    type: 'doughnut',
    data: {
        labels: @json($trackNames),
        datasets: [{
            data: @json($trackCounts),
            backgroundColor: [
                chartColors.primary,
                chartColors.success,
                chartColors.info,
                chartColors.warning,
                chartColors.danger,
                chartColors.secondary,
                '#5a5c69',
                '#2e59d9',
                '#17a673',
                '#2c9faf'
            ],
            borderWidth: 2,
            borderColor: '#fff'
        }]
    },
    options: {
        responsive: true,
        maintainAspectRatio: true,
        plugins: {
            legend: {
                position: 'right',
                labels: {
                    boxWidth: 15,
                    padding: 10
                }
            }
        }
    }
});

// 3. Biểu đồ line: Tiến độ phản biện theo tháng
const reviewsByMonthCtx = document.getElementById('reviewsByMonthChart').getContext('2d');
new Chart(reviewsByMonthCtx, {
    type: 'line',
    data: {
        labels: @json($monthsData),
        datasets: [{
            label: 'Số lượt review',
            data: @json($reviewCountsData),
            borderColor: chartColors.info,
            backgroundColor: 'rgba(54, 185, 204, 0.1)',
            borderWidth: 2,
            tension: 0.3,
            fill: true,
            pointBackgroundColor: chartColors.info,
            pointBorderColor: '#fff',
            pointBorderWidth: 2,
            pointRadius: 4
        }]
    },
    options: {
        responsive: true,
        maintainAspectRatio: true,
        scales: {
            y: {
                beginAtZero: true,
                ticks: {
                    precision: 0
                }
            }
        },
        plugins: {
            legend: {
                display: false
            }
        }
    }
});

// 4. Biểu đồ pie: Trạng thái bài báo
const papersByStatusCtx = document.getElementById('papersByStatusChart').getContext('2d');
new Chart(papersByStatusCtx, {
    type: 'pie',
    data: {
        labels: @json($statusLabels),
        datasets: [{
            data: @json($statusCounts),
            backgroundColor: [
                chartColors.success,
                chartColors.warning,
                chartColors.info,
                chartColors.danger,
                chartColors.secondary
            ],
            borderWidth: 2,
            borderColor: '#fff'
        }]
    },
    options: {
        responsive: true,
        maintainAspectRatio: true,
        plugins: {
            legend: {
                position: 'bottom',
                labels: {
                    padding: 15,
                    boxWidth: 15
                }
            }
        }
    }
});

// Filter function
function applyFilters() {
    const year = document.getElementById('filterYear').value;
    const faculty = document.getElementById('filterFaculty').value;
    
    const params = new URLSearchParams();
    if (year) params.append('year', year);
    if (faculty) params.append('faculty', faculty);
    
    window.location.href = '{{ route("admin.reports.index") }}?' + params.toString();
}

// Allow Enter key to apply filters
document.getElementById('filterYear').addEventListener('keypress', function(e) {
    if (e.key === 'Enter') applyFilters();
});
document.getElementById('filterFaculty').addEventListener('keypress', function(e) {
    if (e.key === 'Enter') applyFilters();
});
</script>
@endpush
