		{
			"name": "4. COI Management (6 APIs)",
			"item": [
				{
					"name": "4.1 Declare COI Manually",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set('coi_id', jsonData.data.coi_id);",
									"    console.log('✅ COI declared:', jsonData.data.coi_id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"paper_id\": {{paper_id}},\n    \"coi_code\": \"ADVISOR_STUDENT\",\n    \"description\": \"The paper author was my PhD advisor at Stanford University from 2018-2022.\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/coi/declare",
							"host": ["{{base_url}}"],
							"path": ["coi", "declare"]
						},
						"description": "Manually declare conflict of interest.\n\nCOI Types:\n- AUTHOR_REVIEWER: Reviewer is also author\n- SAME_INSTITUTION: Same institution\n- COLLABORATION: Recent collaboration (<2 years)\n- ADVISOR_STUDENT: Advisor-student relationship\n- FAMILY_RELATION: Family member\n- FINANCIAL_INTEREST: Financial conflict\n\nPermission: Reviewer (self-declare)"
					},
					"response": []
				},
				{
					"name": "4.1 Declare COI - Collaboration",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"paper_id\": 2,\n    \"coi_code\": \"COLLABORATION\",\n    \"description\": \"Co-authored 2 papers with the author in 2024.\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/coi/declare",
							"host": ["{{base_url}}"],
							"path": ["coi", "declare"]
						}
					},
					"response": []
				},
				{
					"name": "4.2 List Paper COIs",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/papers/{{paper_id}}/cois",
							"host": ["{{base_url}}"],
							"path": ["papers", "{{paper_id}}", "cois"]
						},
						"description": "List all COIs for a specific paper.\n\nPermission: Admin, Chair, Paper Authors"
					},
					"response": []
				},
				{
					"name": "4.3 List All COIs (Admin)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/cois?conference_id={{conference_id}}&per_page=20",
							"host": ["{{base_url}}"],
							"path": ["cois"],
							"query": [
								{
									"key": "conference_id",
									"value": "{{conference_id}}"
								},
								{
									"key": "coi_code",
									"value": "ADVISOR_STUDENT",
									"disabled": true
								},
								{
									"key": "resolution_status",
									"value": "PENDING",
									"disabled": true
								},
								{
									"key": "per_page",
									"value": "20"
								}
							]
						},
						"description": "List all COIs in system.\n\nFilters:\n- conference_id: Required\n- coi_code: Filter by type\n- resolution_status: PENDING, CONFIRMED, REJECTED\n\nPermission: Admin only"
					},
					"response": []
				},
				{
					"name": "4.4 Auto-Detect COI",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"conference_id\": {{conference_id}}\n}"
						},
						"url": {
							"raw": "{{base_url}}/coi/detect",
							"host": ["{{base_url}}"],
							"path": ["coi", "detect"]
						},
						"description": "**AUTO-DETECT COI ALGORITHM**\n\nChecks:\n- Reviewer is also paper author (AUTHOR_REVIEWER)\n\nFuture enhancements:\n- Same institution check\n- Recent collaboration check\n- Co-authorship history\n\nPermission: Admin, Chair"
					},
					"response": []
				},
				{
					"name": "4.5 Resolve COI - CONFIRM",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"decision\": \"CONFIRMED\",\n    \"note\": \"COI confirmed. Removing reviewer assignment.\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/coi/{{coi_id}}/resolve",
							"host": ["{{base_url}}"],
							"path": ["coi", "{{coi_id}}", "resolve"]
						},
						"description": "Resolve COI - Confirm it's valid.\n\nActions:\n- Removes reviewer assignment\n- Updates bidding to CONFLICT\n- Blocks future assignments\n\nPermission: Admin, Chair"
					},
					"response": []
				},
				{
					"name": "4.5 Resolve COI - REJECT",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"decision\": \"REJECTED\",\n    \"note\": \"COI claim is not valid. Collaboration was >5 years ago. Restoring assignment.\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/coi/{{coi_id}}/resolve",
							"host": ["{{base_url}}"],
							"path": ["coi", "{{coi_id}}", "resolve"]
						},
						"description": "Resolve COI - Reject it (not valid).\n\nActions:\n- Restores reviewer assignment (if removed)\n- Allows reviewer to continue\n\nPermission: Admin, Chair"
					},
					"response": []
				},
				{
					"name": "4.6 COI Statistics (Admin)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/coi/statistics?conference_id={{conference_id}}",
							"host": ["{{base_url}}"],
							"path": ["coi", "statistics"],
							"query": [
								{
									"key": "conference_id",
									"value": "{{conference_id}}"
								}
							]
						},
						"description": "Get COI statistics.\n\nIncludes:\n- Total COIs\n- By type breakdown\n- By resolution status\n- Auto-detected vs manual\n- Papers affected\n- Reviewers with COI"
					},
					"response": []
				}
			]
		},
